"""Check the saved secondary projection without fitting or reading predictions."""

import importlib.util
import json
import math
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
PACKAGE = ROOT / "docs/rp4/DEFENSE_PACKAGE/revision_2/correction_6"
PROJECTION = ROOT / "artifacts/rp4_v3_secondary_repair"
RESULT = "docs/rp4/results_v3_revision3.md"
TEST = "tests/contract/test_rp4_v3_secondary_projection.py"
SPEC = importlib.util.spec_from_file_location(
    "secondary_shared_contract", Path(__file__).with_name("test_rp4_saved_holm_closeout.py")
)
assert SPEC and SPEC.loader
shared = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(shared)
readers = shared.readers
PROJECTION_SHA256 = "6280bb4cc8044aeeec7d694a5db224e0a90ba2d2182b742cc2a13c933661a36a"
FAMILIES = ("log_ridge_harq", "lightgbm_qlike")
SETS = ("B0", "B1", "B2")


def _evidence() -> dict:
    return json.loads((PROJECTION / "evidence.json").read_text("utf-8"))


def test_secondary_package_is_sealed_and_fully_bound() -> None:
    shared.assert_sealed_package(PACKAGE, TEST)


def test_projection_preserves_all_saved_facts_and_source_receipts() -> None:
    path = PROJECTION / "evidence.json"
    assert readers.digest(path.read_bytes()) == PROJECTION_SHA256
    evidence = _evidence()
    assert len(evidence["facts"]) == 293
    assert len(evidence["source_sha256"]) == 9
    assert not re.search(r"[A-Za-z]:[\\/]", path.read_text("utf-8"))
    for name, expected in evidence["source_sha256"].items():
        assert readers.digest(shared._safe_file(name).read_bytes()) == expected, name
    for name, fact in evidence["facts"].items():
        assert fact["sha256"] == evidence["source_sha256"][fact["artifact"]]
        value = readers.selected(fact["artifact"], json.dumps(fact["selector"]))
        if "quote" in fact:
            assert isinstance(value, str) and fact["quote"] and fact["quote"] in value, name
        else:
            assert fact["value"] == value, name
    scope = evidence["scope"]
    for key in (
        "new_model_fits",
        "new_auc_calculations",
        "new_bootstrap_runs",
        "new_scientific_evaluations",
        "new_statistical_calculations",
    ):
        assert scope[key] == 0
    assert scope["source_granular_payloads_read"] is scope["sealed_cohorts_read"] is False
    facts = evidence["facts"]
    for key in (
        "closeout_model_fits",
        "closeout_new_inference_calculations",
        "mz_confirmation_receipt_models_fitted",
    ):
        assert facts[key]["value"] == 0
    assert facts["closeout_primary_block_byte_preserved"]["value"] is True
    for key in (
        "closeout_prior_primary_changed",
        "closeout_v4_changed",
        "mz_confirmation_receipt_calibration_formula_changed",
        "mz_confirmation_receipt_stored_forecasts_changed",
        "mz_confirmation_receipt_frozen_artifacts_changed",
        "mz_confirmation_receipt_evaluation_v4_touched",
    ):
        assert facts[key]["value"] is False
    receipt = json.loads((PROJECTION / "projection_receipt_v1.json").read_text("utf-8"))
    assert receipt["schema_version"] == "rp4-v3-secondary-projection-receipt-v1"
    assert receipt["byte_identical_to_verified_draft"] is True
    assert evidence["source_sha256"].items() <= receipt["source_sha256"].items()
    for name, expected in receipt["source_sha256"].items():
        assert readers.digest(shared._safe_file(name).read_bytes()) == expected, name
    assert receipt["verified_draft_sha256"] == PROJECTION_SHA256
    assert receipt["validation"]["facts_selected_and_hashed_passed"] == len(evidence["facts"])
    assert receipt["scope"]["frozen_sources_changed"] is False
    expected_files = {
        (PROJECTION / name).relative_to(ROOT).as_posix()
        for name in ("evidence.json", "README.md", "projection_receipt_v1.json")
    } | {RESULT}
    seen = []
    for line in (PROJECTION / "projection_SHA256SUMS_v1.txt").read_text("utf-8").splitlines():
        expected, name = line.split("  ", 1)
        assert readers.digest(shared._safe_file(name).read_bytes()) == expected, name
        seen.append(name)
    assert len(seen) == len(expected_files) and set(seen) == expected_files
    assert set(receipt["artifacts_sha256"]) == expected_files - {
        (PROJECTION / "projection_receipt_v1.json").relative_to(ROOT).as_posix()
    }
    for field in ("artifacts_sha256", "preexisting_files_sha256"):
        for name, expected in receipt[field].items():
            assert readers.digest(shared._safe_file(name).read_bytes()) == expected, name


def test_auc_is_complete_but_no_within_family_gate_opens_h2() -> None:
    evidence = _evidence()
    facts = evidence["facts"]
    result = (ROOT / RESULT).read_text("utf-8")
    table_rows = [
        [cell.strip() for cell in line.split("|")[1:-1]]
        for line in result.splitlines()
        if line.startswith("|")
    ]
    for window, (sessions, origins) in {
        "primary": (419, 160832),
        "confirmation": (25, 9750),
    }.items():
        index = evidence["indexes"]["auc"][window]
        assert facts[index["sample"]["status"]]["value"] == "COMPUTED"
        assert facts[index["sample"]["N_sessions"]]["value"] == sessions
        assert facts[index["sample"]["N_origins"]]["value"] == origins
        assert facts[index["sample"]["inference_role"]]["value"] == "SECONDARY"
        assert facts[index["sample"]["excluded_sessions"]]["value"] == []
        assert {(row["family"], row["information_set"]) for row in index["models"]} == {
            (family, information_set) for family in FAMILIES for information_set in SETS
        }
        assert len(index["models"]) == 6 and len(index["contrasts"]) == 4
        for family in FAMILIES:
            prefix = f"auc_{window}_{family}_"
            labels = [
                "Primaria" if window == "primary" else "Final",
                "Logística" if family == "log_ridge_harq" else "Árboles binarios",
            ]
            for information_set in SETS:
                record = facts[prefix + information_set]["value"]
                assert record["status"] == "COMPUTED"
                assert 0 <= record["ci_low"] <= record["estimate"] <= record["ci_high"] <= 1
                matching = [row for row in table_rows if row[:3] == [*labels, information_set]]
                assert len(matching) == 1
                assert matching[0][3] == readers.rendered(record["estimate"], ".8f|es")
            assert facts[prefix + "invalid_class_resamples"]["value"] == 0
            h1 = facts[prefix + "B1_over_B0"]["value"]
            h2 = facts[prefix + "B2_over_B1"]["value"]
            for record in (h1, h2):
                assert record["family"] == family and record["endpoint"] == "jump_auc"
                assert record["status"] == "COMPUTED" and record["rejected"] is False
                assert record["inference_role"] == "SECONDARY"
                assert (record["N_sessions"], record["N_origins"]) == (sessions, origins)
                assert record["ci_low"] < 0 < record["ci_high"]
            assert h1["hypothesis_status"] == "NOT_REJECTED"
            assert h1["p_for_decision"] == h1["p_raw"] > h1["alpha"]
            assert h2["hypothesis_status"] == "NOT_TESTED"
            assert h2["p_for_decision"] is None and h2["nominal_p_role"] == "NO_PROMOTABLE"
            assert 0 < h2["p_raw"] < 1
            for record, contrast in ((h1, "H1: B1/B0"), (h2, "H2: B2/B1")):
                matching = [row for row in table_rows if row[:3] == [*labels, contrast]]
                assert len(matching) == 1
                row = matching[0]
                assert row[5] == readers.rendered(record["p_raw"], ".4f|es")
                assert row[6] == ("—" if record["p_for_decision"] is None else row[5])
                assert row[7].strip("`") == record["hypothesis_status"]
        components = facts[f"newton_final_{window}_component_counts"]["value"]
        assert all(row["status"] == "COMPUTED" for row in components)
        assert sum(row["N"] for row in components) == sessions * 6
        assert facts[f"newton_final_{window}_successful_components_refitted"]["value"] == 0
        assert facts[f"newton_final_{window}_prior_attempts_preserved"]["value"] is True
        for kind in ("primary", "quantile", "mz"):
            assert facts[f"newton_final_{window}_{kind}_changed"]["value"] is False
    assert facts["first_pass_primary_N_sessions"]["value"] == 418
    assert facts["first_pass_primary_N_origins"]["value"] == 160442
    first = facts["first_pass_primary_component_counts"]["value"]
    assert sum(row["N"] for row in first if row["status"] == "NO VERIFICABLE") == 1
    assert facts["newton_final_primary_eligible_newton_components"]["value"] == 1
    assert facts["newton_final_confirmation_eligible_newton_components"]["value"] == 0
    gradients = facts["newton_final_primary_gradient_diagnostics"]["value"]
    original = next(row for row in gradients if row["provenance"] == "REUSED_FROZEN_V3")
    repaired = next(row for row in gradients if row["provenance"] == "NEW_MISSING_COMPONENT")
    assert original["new_certificate_required"] is False
    assert original["refit_gradients_above_1e_minus8"] > 0
    assert repaired["new_certificate_required"] is True
    assert (
        repaired["candidate_gradients_above_1e_minus8"]
        == repaired["refit_gradients_above_1e_minus8"]
        == 0
    )
    assert "sin convertirla en una réplica prospectiva nueva" in result
    assert "sin atribuirles retroactivamente el certificado más estricto" in result


def test_mz_raw_diagnostics_do_not_hide_unstable_tree_recalibration() -> None:
    evidence = _evidence()
    facts = evidence["facts"]
    mz = evidence["indexes"]["mz"]
    assert facts["mz_tree_family"]["quote"] == 'family = "lightgbm_qlike"'
    assert facts["mz_formula"]["quote"] == "raw = intercept + slope * forecast"
    assert facts["mz_floor"]["quote"] == "applied = np.maximum(applied, PROBABILITY_FLOOR)"
    for window in ("primary", "confirmation"):
        raw = mz["raw_forecast_calibration"][window]
        expected_keys = {
            f"{family}__{information_set}" for family in FAMILIES for information_set in SETS
        }
        assert len(raw) == 6
        assert {facts[name]["selector"][-1] for name in raw} == expected_keys
        for name in raw:
            fact = facts[name]
            assert fact["selector"][0] == "mincer_zarnowitz"
            assert fact["value"]["status"] == "COMPUTED"
            assert {"intercept", "slope", "joint_a0_b1_hac_p"} <= fact["value"].keys()
        applied = mz["tree_recalibration"][window]
        assert len(applied["models"]) == 3 and len(applied["contrasts"]) == 2
        assert {facts[name]["value"]["information_set"] for name in applied["models"]} == set(SETS)
        for name in applied["contrasts"]:
            record = facts[name]["value"]
            assert record["family"] == "lightgbm_qlike"
            assert record["endpoint"] == "mz_recalibrated_qlike"
            assert record["p_role"] == "bilateral_nominal_diagnostic_not_primary"
        for information_set in SETS:
            record = facts[f"mz_recalibration_{window}_{information_set}"]["value"]
            assert record["calibration_improvement"] < 0
            assert record["recalibrated_qlike"] > record["raw_qlike"]
            identity = {
                key: facts[name]["value"]
                for key, name in mz["identity_audits"][window][information_set].items()
            }
            assert identity["formula_stored_max_abs_difference"] == 0
            assert (
                identity["floor_counter_disagreements"] == identity["scale_relative_error_max"] == 0
            )
            assert identity["floor_hits"] == identity["strictly_negative_affine"]
            assert identity["exact_zero_affine"] == identity["positive_at_or_below_floor"] == 0
            assert (
                identity["nonfinite_origin_fallbacks"]
                == identity["training_identity_fallbacks"]
                == 0
            )
            published, reconstructed = (
                identity["mz_qlike_published"],
                identity["mz_qlike_recomputed"],
            )
            assert published == record["recalibrated_qlike"]
            assert published - reconstructed == identity["published_minus_recomputed"]
            assert math.isclose(
                published,
                reconstructed,
                rel_tol=0,
                abs_tol=max(math.ulp(published), math.ulp(reconstructed)),
            )
            if window == "confirmation" and information_set == "B0":
                assert identity["floor_hits"] == identity["floor_loss_share_percent"] == 0
            else:
                assert identity["floor_hits"] > 0 and identity["floor_loss_share_percent"] > 99
                assert record["recalibrated_qlike"] > 1000 and record["raw_qlike"] < 1
    assert (
        facts["mz_identity_confirmation_B1_published_minus_recomputed"]["value"]
        == -2.2737367544323206e-13
    )
    assert "no es un secundario fiable" in facts["mz_arithmetic_vs_utility"]["quote"]
    assert "otra metodología" in facts["mz_change_would_be_method"]["quote"]
    result = (ROOT / RESULT).read_text("utf-8")
    for phrase in (
        "corresponde exclusivamente a LightGBM",
        "**NO VERIFICABLE**",
        "no se afirma igualdad bit a bit",
        "no hace útil la recalibración",
        "No se han ejecutado ajustes, cálculos de AUC ni remuestreos nuevos",
    ):
        assert phrase in result, phrase
