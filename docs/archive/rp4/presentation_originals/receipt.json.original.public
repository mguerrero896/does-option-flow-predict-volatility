  "verification": {
    "cmd": "$env:UV_PROJECT_ENVIRONMENT='private-input/4b06809c9ca2d51ba83b'\n$env:PYTHONPATH='private-input/0d2012363c94bcf4a831'\n$env:OPENBLAS_NUM_THREADS='4'\n$env:OMP_NUM_THREADS='4'\n$env:POLARS_MAX_THREADS='4'\n\n$env:PYTHONPATH += ';private-input/f0b09867706f786297b8;private-input/e5ce4022c3bb83280dee'\n$env:PYTHONIOENCODING='utf-8'\nuv run --offline --frozen --no-sync python -B -c @'\nimport json,re,xml.etree.ElementTree as ET\nfrom pathlib import Path\nfrom itertools import accumulate\nfrom artifacts.rp4_v4_code import report_v4_checked as report\nfrom artifacts.rp4_code.evaluate import sha256\nroot=Path.cwd()\nfolder=root/'artifacts/rp4_v4_b4'\nmanifest=report.read_json(folder/'report_manifest.json')\nfor key in ('input_sha256','output_sha256'):\n    for name,digest in manifest[key].items():\n        path=Path(name)\n        if not path.is_absolute(): path=root/path\n        assert sha256(path)==digest,(key,name)\nresults={}\nfor horizon in report.LABELS:\n    for window in report.WINDOWS:\n        stage='b2' if window=='primary' else 'b3'\n        data=root/'artifacts'/(f'rp4_v3_{stage}' if horizon==30 else f'rp4_v4_{stage}_rv{horizon}')\n        results[horizon,window]=(report.read_json(data/'summary.json'),report.read_csv(data/'session_losses.csv'))\n        report.verify_results(*results[horizon,window],horizon,window)\ntext=(root/'docs/rp4/results_v4.md').read_text(encoding='utf-8')\nassert all(report.main_table(results,window) in text for window in report.WINDOWS)\nlinks=re.findall(r'\\]\\(([^)]+)\\)',text)\nassert all(((root/'docs/rp4')/name).resolve().is_file() for name in links)\ncurves=0\nfor contrast,base,richer in report.inf.CONTRASTS:\n    tree=ET.parse(folder/(contrast+'.svg'))\n    seen=set()\n    for curve in tree.findall('.//{http://www.w3.org/2000/svg}path'):\n        h=int(curve.attrib['data-horizon']); w=curve.attrib['data-window']; f=curve.attrib['data-family']\n        rows=results[h,w][1]\n        expected=list(accumulate(report.differences(rows,f,base,richer)))[-1]\n        assert float(curve.attrib['data-endpoint'])==expected\n        assert int(curve.attrib['data-sessions'])==len(rows)\n        seen.add((h,w,f)); curves+=1\n        points=re.findall(r'[ML]\\s+([-0-9.]+)\\s+([-0-9.]+)',curve.attrib['d'])\n        assert len(points)==len(rows)+1\n        assert all(0<=float(x)<=1680 and 0<=float(y)<=1320 for x,y in points)\n    assert len(seen)==12\nassert manifest['rv15_primary_winning_families']==['log_ridge_harq']\nassert 'cuarta evaluación de las mismas ventanas' in text and 'No hay v5.' in text\nassert 'NO ABIERTA' in text and 'Los p dentro de una versión no corrigen toda la búsqueda anterior.' in text\nassert manifest['model_fits']==manifest['downloads']==0 and manifest['publication'] is False\nprint(json.dumps({'status':'PASS','windows_checked':6,'tables_checked':2,'figures_checked':2,'curves_checked':curves,'links_checked':len(links),'manifest_sha256':sha256(folder/'report_manifest.json'),'report_sha256':sha256(root/'docs/rp4/results_v4.md'),'source_code_sha256':sha256(root/'artifacts/rp4_v4_code/report_v4_checked.py'),'test_sha256':sha256(root/'artifacts/rp4_v4_code/test_report_checked.py'),'raw_signs_and_scope_preserved':True,'model_fits':0,'new_inference':0},sort_keys=True))\n'@\nexit $LASTEXITCODE",
