# Presence-only configuration names. Never commit values.
FMP_API_KEY=
MASSIVE_API_KEY=
UNUSUAL_WHALES_API_KEY=
MDS650_RESEARCH_ONLY=true

# Data and evidence roots. MDS650_DATA_ROOT is the production store;
# MDS650_EXTERNAL_ROOT redirects bounded rehearsals/tests without changing it.
MDS650_DATA_ROOT=
MDS650_EVIDENCE_ROOT=
MDS650_EXTERNAL_ROOT=
MDS650_RAW_ROOT=
MDS650_BULK_ROOT=
MDS650_RP2_STORE_ROOT=
MDS650_REPO_ROOT=
MDS650_AUDIT_OUT_DIR=
MDS650_AUDIT_RAW_ROOT=

# Publication credentials. Presence is required only by the named scripts.
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Optional provider overrides and legacy aliases retained by active scripts.
MDS650_FMP_API_KEY=
MDS650_MASSIVE_BASE_URL=https://api.massive.com
UNUSUALWHALES_API_KEY=
